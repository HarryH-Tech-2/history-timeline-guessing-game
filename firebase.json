{
  "hosting": {
    "public": "web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/c/**",
        "destination": "/c/index.html"
      },
      {
        "source": "/g/**",
        "destination": "/g/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "history-date-timeline-guesser.firebaseapp.com"
    ],
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Date Guesser",
        "supportEmail": "harry.h379572@gmail.com"
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm run export:catalogue",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "react-native": {
    "analytics_auto_collection_enabled": false
  }
}
