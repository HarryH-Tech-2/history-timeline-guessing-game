# Firebase client config. Copy to `.env` and fill in from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
#
# These are PUBLISHABLE client keys, not secrets — access is enforced by
# Firestore security rules, so they are safe to ship in the app bundle. Only
# vars prefixed with EXPO_PUBLIC_ are inlined into the client build.
#
# Leaving these unset is fine: the app runs fully offline from the local seed
# dataset when Firebase is not configured.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Seed script only (NOT prefixed EXPO_PUBLIC_ — server-side, never bundled) ---
# Path to a Firebase Admin service-account JSON key. Used by `npm run seed:firestore`
# to upload the local categories/questions to Firestore. Keep this file out of git.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Google Sign-In web OAuth client id (client_type 3 in google-services.json).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat PUBLIC SDK keys (safe to ship; receipts are validated server-side).
# Set in the EAS environment for preview/production builds. When unset, dev builds
# simulate purchases and production builds report purchases as unavailable.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
